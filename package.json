{
  "name": "farmsave-africa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "prisma generate --schema=prisma/schema.prisma && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "setup:check": "node --env-file=.env.local scripts/check-setup.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:live": "node --env-file=.env.local node_modules/@playwright/test/cli.js test live",
    "seed:users": "node --env-file=.env.local scripts/seed-neon.mjs",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file=.env.local scripts/seed-neon.mjs --reference-only",
    "test:e2e:local": "node scripts/test-local-backend.mjs",
    "postinstall": "prisma generate --schema=prisma/schema.prisma"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.2",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@prisma/client": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "@aws-sdk/client-s3": "3.1162.0",
    "@aws-sdk/s3-request-presigner": "3.1162.0",
    "next-auth": "4.24.15",
    "bcryptjs": "3.0.3",
    "pg": "8.23.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.68.0",
    "next": "16.4.5",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/pg": "8.23.1",
    "pglite-server": "0.1.5",
    "prisma": "7.10.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "overrides": { "minimatch": "11.0.4", "es-abstract": "1.24.2", "nodemailer": "10.3.1" },
  "engines": { "node": ">=22.18.0" }
}
