NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Development/test database only. Never enable for production.
FARMSAVE_DEV_SEED=false
SEED_PASSWORD=
E2E_LIVE=false
# Optional owned test mailbox; live registration adds a +test suffix.
E2E_REGISTRATION_EMAIL=

# Neon + Prisma (server-only). Pooled URL for the app; direct URL for migrations.
DATABASE_URL=
DIRECT_URL=
DATABASE_POOL_MAX=5
# Generate a random secret of at least 32 characters; never use a public variable.
AUTH_SECRET=
AUTH_URL=http://localhost:3107
NEXTAUTH_URL=http://localhost:3107
AUTH_REQUIRE_EMAIL_VERIFICATION=true
# Transactional email for verification/recovery (Resend).
RESEND_API_KEY=
EMAIL_FROM=
# Private S3-compatible storage (AWS S3, Cloudflare R2 or another compatible provider).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
